# ==========================================
# WorldPulse News Orchestra - Git Ignore Rule Set
# Covers Node.js, Express, Angular 19, Python & Vitest
# ==========================================

# 🔑 Secrets & Environment Configuration
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# 📦 Dependencies & Package Managers
node_modules/
frontend/node_modules/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml

# 🏗️ Build Outputs & Compiled Assets
dist/
frontend/dist/
frontend/.angular/
frontend/out-tsc/
frontend/tmp/
frontend/bazel-out/
build/
out/

# 🧪 Testing & Code Coverage
coverage/
frontend/coverage/
.vitest/
.pytest_cache/
__pycache__/
*.py[cod]
*$py.class

# 🐍 Python Virtual Environments & Packages
.venv/
venv/
ENV/
env/
*.egg-info/
.eggs/
*.egg

# 📝 Logs & Diagnostics
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
testem.log

# 💻 IDEs & Code Editors
.idea/
*.suo
*.user
*.userosv
*.sln
*.swp
*.swo
*.sublime-workspace
*.sublime-project

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json
.history/

# 🍏 / 🪟 Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# 🧹 Temporary Scratch & Lock Files
scratch/
connect.lock